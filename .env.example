# Configure at least one provider below. Every configured provider's models
# show up in the model picker.

# --- Ollama ---------------------------------------------------------------

# Ollama server. Use http://localhost:11434 for a local install,
# or https://ollama.com for Ollama Cloud (requires an API key).
OLLAMA_URL=http://localhost:11434

# Model to preselect. It must be pulled/available on the server above.
OLLAMA_MODEL=

# Optional. Sent as "Authorization: Bearer <key>". Needed for Ollama Cloud or
# a server behind an authenticating proxy; leave empty for a local install.
OLLAMA_API_KEY=

# --- OpenAI ---------------------------------------------------------------

# Your OpenAI API key (https://platform.openai.com/api-keys). Leave empty to
# disable OpenAI.
OPENAI_API_KEY=

# Model to preselect, e.g. gpt-4.1-mini. Used when OLLAMA_MODEL is empty.
OPENAI_MODEL=

# Optional. Point this at an OpenAI-compatible server instead of OpenAI.
# Defaults to https://api.openai.com/v1.
OPENAI_BASE_URL=

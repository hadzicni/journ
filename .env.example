# Ollama server. Use http://localhost:11434 for a local install,
# or https://ollama.com for Ollama Cloud (requires an API key).
OLLAMA_URL=http://localhost:11434

# Model to generate with. It must be pulled/available on the server above.
OLLAMA_MODEL=

# Optional. Sent as "Authorization: Bearer <key>". Needed for Ollama Cloud or
# a server behind an authenticating proxy; leave empty for a local install.
OLLAMA_API_KEY=
